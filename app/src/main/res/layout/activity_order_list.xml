<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food Orders"
        android:textStyle="bold"
        android:textSize="26sp"
        android:textColor="#40271B"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvOrderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="0 orders"
        android:textColor="#70594B"
        android:layout_marginLeft="20dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnAddFromList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="+ New Order"
        android:layout_marginLeft="20dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:text="No orders yet. Tap New Order to get started."
        android:padding="24dp"
        android:textColor="#70594B" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"

        android:paddingBottom="12dp" />

</LinearLayout>